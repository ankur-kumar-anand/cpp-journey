//Take 'n' and 'r' as input and print nCr and nPr. (Factorials !)
#include<iostream>
using namespace std;
int fact(int x){
    int fact=1;
    for(int i=1;i<=x;i++){
        fact=fact*i;
    }
    return fact;
}
int main(){
    int n,r;
    cout<<"Enter n and r :"<<endl;
    cin>>n>>r;
    
    int ncr =fact(n)/(fact(r)*fact(n-r));
    cout<<"nCr: "<<ncr<<endl;
    
    int npr =fact(n)/(fact(n-r));
    cout<<"nPr: "<<npr<<endl;
}